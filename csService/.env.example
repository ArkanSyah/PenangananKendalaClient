PORT=3001
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=sk-your-api-key-here
AI_MODEL=ag/gemini-3.8-flash-high

# PostgreSQL Database Configuration (Set DB_ENABLED=true untuk menghubungkan langsung ke PostgreSQL)
DB_ENABLED=false
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=teknobot_cs_db
PGUSER=teknobot_cs
PGPASSWORD=your_postgres_password

# Fallback JSON Paths (Digunakan saat DB_ENABLED=false)
KNOWLEDGE_TICKETS_PATH=./data/data_kendala_client.json
KNOWLEDGE_FAQ_PATH=./data/faq.json
SESSIONS_PATH=./data/sessions.json
